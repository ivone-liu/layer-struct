{
  "name": "layer-struct-ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "skills:install": "node bin/install-skill.mjs",
    "mcp:add": "node bin/manage-mcp.mjs add",
    "mcp:add-url": "node bin/manage-mcp.mjs add-url",
    "mcp:remove": "node bin/manage-mcp.mjs remove",
    "mcp:list": "node bin/manage-mcp.mjs list",
    "mcp:enable": "node bin/manage-mcp.mjs enable",
    "mcp:disable": "node bin/manage-mcp.mjs disable"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
