# Cloud model service. OpenAI-compatible endpoints are expected.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key
AI_ROUTER_MODEL=gpt-4.1-mini
AI_CHAT_MODEL=gpt-4.1
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536

# Local persistence.
PORT=3000
DATA_DIR=./data
SQLITE_PATH=./data/orchestrator.sqlite
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE=document_chunks

# Runtime controls.
# Non-stream AI requests use AI_REQUEST_TIMEOUT_MS. Streaming chat generation uses AI_STREAM_* timeouts.
AI_REQUEST_TIMEOUT_MS=60000
AI_STREAM_CONNECT_TIMEOUT_MS=30000
AI_STREAM_FIRST_TOKEN_TIMEOUT_MS=60000
AI_STREAM_IDLE_TIMEOUT_MS=60000
AI_STREAM_TOTAL_TIMEOUT_MS=180000
DEFAULT_PROJECT_ID=default
